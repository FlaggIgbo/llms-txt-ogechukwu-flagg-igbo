# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/llmstxt_directory?schema=public"

# Storage ("minio" for local Docker S3 cluster, "r2" for production Cloudflare R2)
STORAGE_PROVIDER="minio"

# Local MinIO S3 cluster settings (matches infra/docker-compose.yml)
# Web Console: http://localhost:9001 (Username: minioadmin / Password: minioadmin)
# S3_ENDPOINT="http://localhost:9000"
# S3_PUBLIC_URL="http://localhost:9000"
# AWS_ACCESS_KEY_ID="minioadmin"
# AWS_SECRET_ACCESS_KEY="minioadmin"

# Cloudflare R2 settings
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_LLMS_TXT_BUCKET="llmstxt-files-bucket"
R2_UPDATE_LOGS_BUCKET="llmstxt-update-logs-bucket"
R2_PUBLIC_URL=""

# API Gateway & Frontend
API_PORT="4000"
VITE_API_BASE_URL="http://localhost:4000"

# Cron Schedule (default: every day at midnight)
CRON_SCHEDULE="0 0 * * *"

# Gemini API (for Stage 4: categorization & summaries in worker)
GEMINI_API_KEY=""

# Sentry (optional error monitoring)
SENTRY_DSN=""
VITE_SENTRY_DSN=""
