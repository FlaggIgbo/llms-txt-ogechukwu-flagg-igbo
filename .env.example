# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/llmstxt_directory?schema=public"

# Redis / Queue (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"
QUEUE_NAME="llmstxt-generation-queue"

# AWS S3 / LocalStack Storage
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
S3_LLMS_TXT_BUCKET="llmstxt-files-bucket"
S3_UPDATE_LOGS_BUCKET="llmstxt-update-logs-bucket"

# API Gateway & Frontend
API_PORT="4000"
VITE_API_BASE_URL="http://localhost:4000"

# Cron Schedule (default: every day at midnight)
CRON_SCHEDULE="0 0 * * *"
