{
  "name": "llms-txt-ogechukwu-flagg-igbo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for the llms.txt directory service (React frontend, API gateway, async queue worker, and scheduled cron updater)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@llmstxt/web",
    "dev:api": "npm run dev --workspace=@llmstxt/api",
    "dev:worker": "npm run dev --workspace=@llmstxt/worker",
    "dev:cron": "npm run dev --workspace=@llmstxt/cron-updater",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "tsx scripts/e2e-playwright-flow.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "npm run db:migrate --workspace=@llmstxt/database",
    "screenshots": "tsx scripts/generate-screenshots.ts",
    "screenshots:check": "./scripts/pre-push-screenshots.sh"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
