{
  "name": "@llmstxt/database",
  "version": "1.0.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:generate": "prisma generate --schema=schema.prisma",
    "db:push": "prisma db push --schema=schema.prisma",
    "db:studio": "prisma studio --schema=schema.prisma",
    "db:migrate": "prisma migrate dev --schema=schema.prisma"
  },
  "dependencies": {
    "@llmstxt/logger": "*",
    "@llmstxt/shared-types": "*",
    "@prisma/client": "^6.19.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.19.3",
    "typescript": "^5.6.3"
  }
}
